{
  "name": "tt-api",
  "version": "1.0.0",
  "description": "API de tennis de table",
  "main": "app.ts",
  "scripts": {
    "start": "tsx src/app.ts",
    "test": "tsx --test --test-concurrency=1 'src/**/*.test.ts'",
    "test:http:db": "npm run db:local:setup && DATABASE_URL=$(bash ./scripts/postgres-local.sh url --raw) npm test",
    "db:seed": "tsx src/db/seed-run.ts",
    "openapi:generate-type": "npx openapi-typescript ./contracts/TT-api-contract.openapi.yaml -o ./src/types/api.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:local:up": "bash ./scripts/postgres-local.sh up",
    "db:local:down": "bash ./scripts/postgres-local.sh down",
    "db:local:status": "bash ./scripts/postgres-local.sh status",
    "db:local:logs": "bash ./scripts/postgres-local.sh logs",
    "db:local:url": "bash ./scripts/postgres-local.sh url",
    "db:local:reset": "bash ./scripts/postgres-local.sh reset",
    "db:local:destroy": "bash ./scripts/postgres-local.sh destroy",
    "db:local:setup": "bash ./scripts/postgres-local.sh up && DATABASE_URL=$(bash ./scripts/postgres-local.sh url --raw) npm run db:migrate && DATABASE_URL=$(bash ./scripts/postgres-local.sh url --raw) npm run db:seed",
    "prettier": "npx prettier --write src/"
  },
  "type": "module",
  "author": "Benjamin FRANCHETEAU",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-seed": "^0.3.1",
    "fast-xml-parser": "^5.11.0",
    "fastify": "^5.12.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
